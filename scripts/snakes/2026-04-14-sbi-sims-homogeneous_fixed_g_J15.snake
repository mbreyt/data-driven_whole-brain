@jax.jit
def gfun(x, sqrt_dt, nsig=0.034):
    steps, nodes, stvar = x.shape
    sigs = jnp.tile(jnp.sqrt(2*jnp.array([nsig, 2*nsig])), (steps, nodes, 1))
    return x*sqrt_dt*sigs

@jax.jit
def mpr_r_positive(rv):
    r, v = rv[:,0:1], rv[:,1:]
    return jnp.c_[ r*(r>0), v ]

